<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    NFC is DELIBERATELY NOT DECLARED HERE.
    ======================================
    Reading a passport's eMRTD chip needs android.permission.NFC, but a library
    manifest is MERGED into every host app, so declaring it here gave the
    permission to every integrator — including the majority whose workflows
    never touch a chip, and who had no way to remove it. That is the opposite
    of opt-in, and it silently contradicted the config plugin's own `nfc`
    option, which defaults to OFF.

    The permission AND the feature are now written by app.plugin.js, and only
    on `nfc: true`. They must travel TOGETHER — see ensureNfcFeatureOptional()
    there for why the feature is not an optional extra: Android infers
    `required="true"` from the permission alone, which hides the host app from
    every device with no NFC radio.

    The chip step still checks availability at runtime and auto-skips on a
    device with no radio, so a host that opts out loses nothing else.
  -->

  <!--
    Package VISIBILITY, not a permission: Android 11+ hides other apps from
    PackageManager unless they are named here. These are the root managers the
    Device Intelligence integrity check looks for (AndroidIntegrityChecks.kt,
    keep the two lists in step). Without this block the check could only ever
    answer "not installed". Merged into the host app, it lets the host see
    exactly these packages and nothing else.
  -->
  <queries>
    <package android:name="com.topjohnwu.magisk" />
    <package android:name="eu.chainfire.supersu" />
    <package android:name="com.koushikdutta.superuser" />
    <package android:name="com.noshufou.android.su" />
    <package android:name="com.thirdparty.superuser" />
    <package android:name="com.kingroot.kinguser" />
    <package android:name="com.kingo.root" />
    <package android:name="me.weishu.kernelsu" />
    <package android:name="com.devadvance.rootcloak" />
  </queries>

  <application>
    <!--
      ML Kit models are downloaded on demand by Play Services. Naming them here
      makes Play Services fetch them at INSTALL time, so the first liveness or
      MRZ scan does not pay the download cost — which on a slow connection is
      the difference between a step that works and one the user abandons.
    -->
    <meta-data
      android:name="com.google.mlkit.vision.DEPENDENCIES"
      android:value="face,ocr" />
  </application>
</manifest>
