    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--openssl-legacy-provider jest",
    "specs": "nitrogen"
  },
  "keywords": [
    "kyc",
    "identity",
    "verification",
    "liveness",
    "expo",
    "react-native"
  ],
  "license": "MIT",
